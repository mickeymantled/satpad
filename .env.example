# Copy to .env (gitignored). Never commit real values.

# --- RPC ---
SOLANA_RPC_URL=http://127.0.0.1:8899        # local fork (scripts/local-fork.sh); mainnet: Helius/Triton URL
FORK_RPC_URL=https://api.mainnet-beta.solana.com   # source for test-validator clones

# --- Keys (paths to JSON keypairs; keeper/LP/rewards are hot keys with narrow program powers) ---
DEPLOYER_KEYPAIR=                 # vault initialize only
ADMIN_KEYPAIR=                    # hardware wallet via scripts only (pause, split, wallets, recover)
UPGRADE_AUTHORITY_KEYPAIR=        # local fork only; mainnet = Squads vault (use --print-ix)
SATPAD_RECOVERY_ADDRESS=          # must equal the program's compiled RECOVERY_ADDRESS
KEEPER_KEYPAIR=
LP_WALLET_KEYPAIR=
REWARDS_WALLET_KEYPAIR=

# --- Addresses (filled after satpad_vault initialize / $SATPAD launch) ---
SATPAD_VAULT_PROGRAM_ID=
SATPAD_MINT=
SATPAD_POOL=
SATPAD_LP_MINT=
PYTH_BTC_USD_FEED=

# --- Keeper ---
KEEPER_INSTANCE=keeper-1
PRIORITY_FEE_MODE=fixed                  # live (Helius getPriorityFeeEstimate → getRecentPrioritizationFees → min) | fixed (fork)
FIXED_PRIORITY_FEE_MICRO_LAMPORTS=1000
PRIORITY_FEE_MIN_MICRO_LAMPORTS=1000
PRIORITY_FEE_MAX_MICRO_LAMPORTS=2000000
COMPUTE_UNIT_LIMIT=400000
MAX_SEND_ATTEMPTS=5
SETTLE_INTERVAL_MS=60000
HEALTH_PORT=8080
# --- Thresholds (base units, 8 decimals for wBTC) ---
SETTLE_DUST_THRESHOLD=1000
BUYBACK_MIN=10000

# --- Indexer ---
POLL_INTERVAL_MS=5000
RPC_RATE_PER_SECOND=4                   # polling budget; keep low on the shared fork
RPC_BURST=8
# WEBHOOK_PORT=8090                      # Helius raw webhook receiver (prod); needs WEBHOOK_AUTH_HEADER
# WEBHOOK_AUTH_HEADER=
EXTRA_ADDRESSES=                        # comma-separated, e.g. the $SATPAD pool
# --- API ---
API_PORT=8083
PRICE_SOURCE=fixed                      # pyth (on-chain feed 4cSM2e6r…, V7) | fixed
BTC_USD_CENTS=10000000                  # fixed dev price: $100,000.00
PRICE_CACHE_MS=30000
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=*                          # production: https://satpad.example (comma-separated)
METADATA_BACKEND=api                    # pump (primary, D18) | api (fallback / fork)
PUBLIC_API_URL=http://127.0.0.1:8083     # origin used in /m/:id metadata URIs (api backend)
PUBLIC_WEB_URL=http://127.0.0.1:3000     # website back-link in coin metadata (SPEC "Metadata")
# PUMP_IPFS_URL=                        # default https://pump.fun/api/ipfs (V16)
# LAUNCH_ALT=                           # D14 lookup table address, served in GET /config (scripts/create-launch-alt.ts)
# JUPITER_API_URL=                      # V10: default https://api.jup.ag/swap/v1; "off" disables the SOL→BTC proxy
# JUPITER_API_KEY=                      # optional (keyless tier is 0.5 req/s); never shipped to the browser
# DEV_FAUCET_KEYPAIR=                   # fork only (D17): scripts/fork-keys/wbtc-authority.json
# --- Indexer / API ---
DATABASE_URL=postgres://satpad:satpad@127.0.0.1:55433/satpad   # local: docker run -d --name satpad-postgres -e POSTGRES_USER=satpad -e POSTGRES_PASSWORD=satpad -e POSTGRES_DB=satpad -p 55433:5432 postgres:16-alpine
HELIUS_WEBHOOK_SECRET=

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web (NEXT_PUBLIC_* reach the browser; never secrets) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8083
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8083/live
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_LAUNCH_ALT=                 # scripts/create-launch-alt.ts (D14)
NEXT_PUBLIC_DEV_SWAP=                   # 1 only on the fork (D17); production builds fail if the module is present
NEXT_PUBLIC_EXPLORER=https://solscan.io
