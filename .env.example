# Copy to .env (gitignored). Never commit real values.

# --- RPC ---
SOLANA_RPC_URL=http://127.0.0.1:8899        # local fork (scripts/local-fork.sh); mainnet: Helius/Triton URL
FORK_RPC_URL=https://api.mainnet-beta.solana.com   # source for test-validator clones

# --- Keys (paths to JSON keypairs; keeper/LP/rewards are hot keys with narrow program powers) ---
DEPLOYER_KEYPAIR=                 # vault initialize only
ADMIN_KEYPAIR=                    # hardware wallet via scripts only (pause, split, wallets, recover)
UPGRADE_AUTHORITY_KEYPAIR=        # local fork only; mainnet = Squads vault (use --print-ix)
SATPAD_RECOVERY_ADDRESS=          # must equal the program's compiled RECOVERY_ADDRESS
KEEPER_KEYPAIR=
LP_WALLET_KEYPAIR=
REWARDS_WALLET_KEYPAIR=

# --- Addresses (filled after satpad_vault initialize / $SATPAD launch) ---
SATPAD_VAULT_PROGRAM_ID=
SATPAD_MINT=
SATPAD_POOL=
SATPAD_LP_MINT=
PYTH_BTC_USD_FEED=

# --- Keeper ---
KEEPER_INSTANCE=keeper-1
PRIORITY_FEE_MODE=fixed                  # live (Helius getPriorityFeeEstimate → getRecentPrioritizationFees → min) | fixed (fork)
FIXED_PRIORITY_FEE_MICRO_LAMPORTS=1000
PRIORITY_FEE_MIN_MICRO_LAMPORTS=1000
PRIORITY_FEE_MAX_MICRO_LAMPORTS=2000000
COMPUTE_UNIT_LIMIT=400000
MAX_SEND_ATTEMPTS=5
SETTLE_INTERVAL_MS=60000
HEALTH_PORT=8080
# --- Thresholds (base units, 8 decimals for wBTC) ---
SETTLE_DUST_THRESHOLD=1000
BUYBACK_MIN=10000

# --- Indexer / API ---
DATABASE_URL=postgres://satpad:satpad@127.0.0.1:55433/satpad   # local: docker run -d --name satpad-postgres -e POSTGRES_USER=satpad -e POSTGRES_PASSWORD=satpad -e POSTGRES_DB=satpad -p 55433:5432 postgres:16-alpine
HELIUS_WEBHOOK_SECRET=

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
