{
  "name": "satpad",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "fork": "scripts/local-fork.sh",
    "fork:smoke": "tsx scripts/fork-smoke.ts",
    "fork:m1": "tsx scripts/fork-create-and-buy.ts",
    "build:vault": "scripts/build-vault.sh",
    "test:vault": "scripts/build-vault.sh && pnpm --filter @satpad/tests test",
    "vault:initialize": "tsx scripts/vault-initialize.ts",
    "vault:set-split": "tsx scripts/vault-set-split.ts",
    "vault:set-wallets": "tsx scripts/vault-set-wallets.ts",
    "vault:set-pause": "tsx scripts/vault-set-pause.ts",
    "vault:recover": "tsx scripts/vault-recover.ts",
    "vault:set-lp": "tsx scripts/vault-set-lp.ts",
    "fork:m2": "tsx scripts/fork-m2-settle.ts",
    "repro:sbpf": "tsx scripts/repro-sbpf.ts",
    "db:migrate": "pnpm --filter @satpad/db migrate",
    "db:generate": "pnpm --filter @satpad/db generate"
  },
  "dependencies": {
    "@satpad/sdk": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@pump-fun/pump-sdk": "2.0.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.20.5",
    "bn.js": "^5.2.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0",
    "@coral-xyz/anchor": "^0.32.1"
  }
}
